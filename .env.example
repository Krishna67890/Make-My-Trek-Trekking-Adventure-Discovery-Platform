# Make My Trek Frontend Environment Configuration
# Copy this file to .env or .env.local

# Firebase Web App Configuration (get from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cesium Ion Access Token (for 3D Geographic Terrain of Anjaneri Hills)
# Get a free token at: https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here

# Backend API URL
VITE_API_URL=http://localhost:5000

# Razorpay Key ID (Public key for checkout popup)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Phone Number Verification Token
VITE_PHONE_NUMBER_VERIFICATION_TOKEN=your_phone_verification_token_here
